# Copy this file to .env and fill in real values. Never commit the real .env.

# Gemini API key (https://aistudio.google.com/apikey)
# Used only for final relevance scoring/ranking/summarization of an already
# filtered shortlist -- NOT for searching the web (see README for why).
GEMINI_API_KEY=

# Brevo (Sendinblue) SMTP relay credentials, from https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Sender must be a verified sender/domain in your Brevo account, or delivery will fail.
EMAIL_FROM=
# Recipient of the daily digest.
EMAIL_TO=
